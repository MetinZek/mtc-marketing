# ─────────────────────────────────────────────────────────────
# MTC — environment variables
# Copy to .env.local and fill in. Stage 1 runs fully on CMS_PROVIDER=local
# with no backend; the Supabase vars are wired in a later stage.
# ─────────────────────────────────────────────────────────────

# Public site URL — used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Content source: "local" (JSON store seeded from src/content/data) or "supabase".
CMS_PROVIDER=local

# ── CMS database (Supabase Postgres) ────────────────────────
# REQUIRED on Vercel — all CMS reads/writes (projects, services, team,
# journal, testimonials, clients, contact submissions, uploaded images)
# go here. Server-only: never prefix with NEXT_PUBLIC_.
# Supabase → Project Settings → Database → Connection string →
# "Transaction pooler" (port 6543), with your database password filled in.
# Leave unset locally to use the development-only .data/ JSON store.
# First-time setup: npm run db:migrate && npm run db:import
DATABASE_URL=

# ── Admin panel (/admin) ────────────────────────────────────
# Shared operator password for the CMS sign-in.
ADMIN_PASSWORD=
# 32+ random characters — signs the admin session cookie.
ADMIN_SESSION_SECRET=

# ── Contact form email (Resend) ─────────────────────────────
# Notifies info@mtcmarketing.co on every submission. Get the key from
# https://resend.com/api-keys — server-only, never exposed to the client.
RESEND_API_KEY=
# Sender address. Must be on a domain verified in Resend
# (https://resend.com/domains) — an unverified/unowned domain will fail
# to send. Resend's shared onboarding@resend.dev works for testing only.
CONTACT_FROM_EMAIL=

# ── Project video uploads (Supabase Storage) ────────────────
# REQUIRED for the admin "Project Video" upload whenever DATABASE_URL is
# set. The browser uploads straight to Storage with a one-off signed URL
# (videos exceed Vercel's 4.5MB request limit); the public bucket
# "project-videos" is created automatically on the first upload.
# Supabase → Project Settings → API: Project URL + service_role/secret
# key. Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Supabase (later stage) ──────────────────────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
